---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <div class="prose" set:html={item.a} />
    </details>
  ))}
</div>
<style>
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 22px 40px 22px 0; font-weight: 700; font-size: 1.1rem; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: '+'; position: absolute; right: 4px; top: 16px; font-size: 1.8rem; font-weight: 400; color: var(--coral); transition: transform 0.2s; }
  details[open] summary::after { transform: rotate(45deg); }
  details .prose { padding: 0 0 22px; }
</style>
