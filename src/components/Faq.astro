---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((item) => (
    <details>
      <summary>{item.q}</summary>
      <div class="prose" set:html={item.a} />
    </details>
  ))}
</div>
<style>
  details { border-bottom: 1px solid var(--line); }
  summary { cursor: pointer; list-style: none; padding: 22px 40px 22px 0; font-weight: 700; font-size: 1.1rem; position: relative; }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--violet); }
  /* A plus drawn with two bars; the vertical one folds away when the answer opens. */
  summary::before, summary::after { content: ''; position: absolute; right: 8px; top: 50%; width: 18px; height: 2.5px; margin-top: -1px; background: var(--coral-deep); border-radius: 2px; transition: transform 0.25s var(--ease-out); }
  summary::after { transform: rotate(90deg); }
  details[open] summary::after { transform: rotate(0deg); }
  details .prose { padding: 0 0 22px; }
</style>
