---
import { routes, ui, up, type Lang } from '../lib/site';

interface Props { lang: Lang; alt?: string }
const { lang, alt } = Astro.props;
const t = ui[lang];
const path = Astro.url.pathname;
const esHref = lang === 'es' ? path : alt ?? routes.home.es;
const enHref = lang === 'en' ? path : alt ?? routes.home.en;
---
<header class="top">
  <div class="wrap bar">
    <a class="logo" href={routes.home[lang]} aria-label="Melza">
      <img src={up('2020/11/logo-melza.png')} alt="Melza" width="140" height="40" />
    </a>
    <button class="toggle" type="button" aria-expanded="false" aria-controls="nav">
      <span class="sr">{t.menu}</span><span class="burger" aria-hidden="true"></span>
    </button>
    <nav id="nav" class="nav" aria-label={t.menu}>
      <ul>
        {t.nav.map((item) => (
          <li><a href={item.href} aria-current={item.href === path ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
      <div class="langs">
        <a href={esHref} hreflang="es" lang="es" aria-current={lang === 'es' ? 'true' : undefined}>ES</a>
        <a href={enHref} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      </div>
    </nav>
  </div>
</header>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.toggle')!;
  const nav = document.getElementById('nav')!;
  btn.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('open', open);
  });
  nav.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a')) { btn.setAttribute('aria-expanded', 'false'); nav.classList.remove('open'); }
  });
</script>
<style>
  .top { position: sticky; top: 0; z-index: 50; background: #fff; border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; min-height: 76px; gap: 24px; }
  .logo img { height: 40px; width: auto; }
  .nav { display: flex; align-items: center; gap: 28px; }
  .nav ul { display: flex; gap: 26px; list-style: none; margin: 0; padding: 0; }
  .nav a { text-decoration: none; font-weight: 600; font-size: 0.98rem; }
  .nav ul a { display: inline-flex; align-items: center; min-height: 44px; }
  .nav ul a:hover, .nav ul a[aria-current] { color: var(--coral-deep); }
  .langs { display: flex; gap: 10px; font-size: 0.9rem; }
  .langs a { display: inline-grid; place-items: center; min-width: 44px; min-height: 44px; }
  .langs a[aria-current] { font-weight: 800; text-decoration: underline; text-decoration-thickness: 3px; text-decoration-color: var(--coral); text-underline-offset: 6px; }
  .toggle { display: none; place-items: center; width: 48px; height: 48px; margin-right: -10px; background: none; border: 0; padding: 0; cursor: pointer; }
  .burger, .burger::before, .burger::after { display: block; width: 26px; height: 2px; background: var(--ink); position: relative; transition: transform 0.2s; }
  .burger::before, .burger::after { content: ''; position: absolute; }
  .burger::before { top: -8px; }
  .burger::after { top: 8px; }
  .toggle[aria-expanded='true'] .burger { background: transparent; }
  .toggle[aria-expanded='true'] .burger::before { transform: translateY(8px) rotate(45deg); }
  .toggle[aria-expanded='true'] .burger::after { transform: translateY(-8px) rotate(-45deg); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }

  @media (max-width: 900px) {
    .toggle { display: grid; }
    .nav { position: fixed; inset: 76px 0 auto 0; background: #fff; flex-direction: column; align-items: flex-start; padding: 24px var(--gutter) 32px; gap: 20px; border-bottom: 1px solid var(--line); transform: translateY(-8px); opacity: 0; visibility: hidden; transition: transform 0.25s var(--ease-out), opacity 0.2s, visibility 0s 0.25s; box-shadow: 0 16px 30px rgba(56, 66, 68, 0.12); }
    .nav.open { transform: none; opacity: 1; visibility: visible; transition: transform 0.25s var(--ease-out), opacity 0.2s; }
    .nav ul { flex-direction: column; gap: 14px; }
    .nav ul a { font-size: 1.3rem; }
  }
</style>
