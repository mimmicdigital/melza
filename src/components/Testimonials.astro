---
interface Item { quote: string; name: string; role: string }
interface Props { items: Item[] }
const { items } = Astro.props;
---
<div class="quotes">
  {items.map((q) => (
    <figure>
      <blockquote>“{q.quote}”</blockquote>
      <figcaption><strong>{q.name}</strong><span>{q.role}</span></figcaption>
    </figure>
  ))}
</div>
<style>
  .quotes { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; }
  figure { margin: 0; background: #fff; border-radius: var(--radius); padding: 30px 28px; box-shadow: 0 10px 30px rgba(56, 66, 68, 0.08); display: flex; flex-direction: column; justify-content: space-between; gap: 20px; }
  blockquote { margin: 0; font-size: 0.98rem; line-height: 1.6; }
  figcaption { display: grid; gap: 2px; font-size: 0.9rem; }
  figcaption strong { color: var(--violet); }
  figcaption span { color: #59625f; }
</style>
