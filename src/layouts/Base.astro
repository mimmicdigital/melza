---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site, up, type Lang } from '../lib/site';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path of the same page in the other language, if there is one. */
  alt?: string;
  image?: string;
  noindex?: boolean;
  ld?: Record<string, unknown>[];
}

const { lang, title, description, alt, image = up('2020/11/home-BG-img.jpg'), noindex = false, ld = [] } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, site.url).href;
const es = lang === 'es' ? path : alt;
const en = lang === 'en' ? path : alt;

const org = {
  '@context': 'https://schema.org',
  '@type': 'EmploymentAgency',
  name: 'Melza',
  legalName: 'Melza Consulting S.L.',
  url: site.url,
  logo: new URL(up('2020/11/logo-melza.png'), site.url).href,
  email: site.email,
  telephone: site.phone,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.address.street,
    postalCode: site.address.zip,
    addressLocality: site.address.city,
    addressCountry: site.address.country,
  },
  sameAs: [site.linkedin],
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {es && en && <link rel="alternate" hreflang="es" href={new URL(es, site.url).href} />}
    {es && en && <link rel="alternate" hreflang="en" href={new URL(en, site.url).href} />}
    {es && en && <link rel="alternate" hreflang="x-default" href={new URL(es, site.url).href} />}
    <link rel="icon" href={up('2020/11/cropped-favicon-32x32.png')} sizes="32x32" />
    <link rel="icon" href={up('2020/11/cropped-favicon-192x192.png')} sizes="192x192" />
    <link rel="apple-touch-icon" href={up('2020/11/cropped-favicon-180x180.png')} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Melza" />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).href} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    {[org, ...ld].map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
    <script is:inline define:vars={{ gaId: site.gaId }}>
      // Google Consent Mode: analytics stays cookieless until the visitor accepts in the cookie banner.
      window.dataLayer = window.dataLayer || [];
      window.gtag = function () { window.dataLayer.push(arguments); };
      let choice = null;
      // Stored as "granted:<time>" or "denied:<time>"; a choice older than 24 months is asked again (AEPD guidance).
      try { const [v, at] = (localStorage.getItem('melza-consent') || '').split(':'); if (Date.now() - Number(at) < 730 * 864e5) choice = v; } catch {}
      gtag('consent', 'default', { ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied', analytics_storage: choice === 'granted' ? 'granted' : 'denied' });
      gtag('js', new Date());
      gtag('config', gaId);
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${site.gaId}`}></script>
  </head>
  <body>
    <a class="skip" href="#main">{lang === 'es' ? 'Saltar al contenido' : 'Skip to content'}</a>
    <Header lang={lang} alt={alt} />
    <main id="main"><slot /></main>
    <Footer lang={lang} />
    <CookieBanner lang={lang} />
    <script>
      // Fade sections in as they scroll into view, like the original site's animations.
      const io = new IntersectionObserver((entries) => {
        for (const e of entries) if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
      }, { rootMargin: '0px 0px -10% 0px' });
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
      // Lead forms report a GA4 event (only sent if the visitor accepted analytics cookies).
      const gtag = (window as unknown as { gtag?: (...args: unknown[]) => void }).gtag;
      document.querySelectorAll<HTMLFormElement>('form[data-event]').forEach((form) => {
        form.addEventListener('submit', () => gtag?.('event', form.dataset.event!, { transport_type: 'beacon' }));
      });
    </script>
  </body>
</html>
