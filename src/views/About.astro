---
import Base from '../layouts/Base.astro';
import Hl from '../components/Hl.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { routes, up, type Lang } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;

const team = [
  { first: 'Cristina', last: 'Zamora', img: '2020/12/about-cristina-zamora.jpg', email: 'cristina@melza.eu', linkedin: 'https://www.linkedin.com/in/cristinazamoracollantes/' },
  { first: 'Cristian', last: 'Melero', img: '2020/12/about-cristian-melero.jpg', email: 'melero.c@melza.eu', linkedin: 'https://www.linkedin.com/in/cristianmelero/' },
];

const t = {
  es: {
    title: 'Melza | Agile Tech Headhunting & Recruiting | ¿EMPEZAMOS?',
    description: 'En Melza llevamos 5 años demostrando que es posible ir mucho más allá del clásico recruiting. Si necesitas talento tech, ¡hablemos!',
    h1: ['Si buscas', 'resultados distintos', 'no hagas siempre', 'lo mismo'],
    intro: '¡Somos hacedores! DE ACCIÓN. El ecosistema tech está más vivo y cambiante que nunca. Llevamos 5 años demostrando que es posible ir mucho más allá del clásico recruiting.',
    introStrong: 'Si necesitas talento tech, ¡hablemos!',
    talk: "Let's talk",
    what: ['Qué ', 'hacemos'],
    services: [
      ['Tech Headhunting', 'Búsqueda directa de perfiles de negocio y developers', '2020/12/about-picto-3.png'],
      ['HR Dream Team', 'Construimos tu equipo interno de Recursos Humanos', '2020/12/about-picto-2.png'],
      ['Employer Branding', 'Definimos tu propuesta de valor como marca empleadora', '2020/12/about-picto-1.png'],
    ],
    how: [['No es el ', 'qué'], ['sino el ', 'cómo']],
    values: ['Calidad, calidad, calidad', 'Flexibilidad, agilidad y energía'],
    teamTitle: 'El equipo',
    roles: ['Co-founder multitasker', 'Co-founder, consultor'],
    bios: [
      'Multitasker, inquieta y optimista. Le flipan los documentales. Detalle al máximo nivel. Cris hace magia con procesos de producto y negocio.',
      'Techie a tope y deportista. La mente estratégica del equipo. Es un crack gestionando procesos de Data, Agile/Scrum, Security y DevOps.',
    ],
    write: 'Escribir a',
  },
  en: {
    title: 'Melza | Agile Tech Headhunting & Recruiting | SHOULD WE START?',
    description: "At Melza, we've proved that going beyond classic recruiting is possible and have been doing it for over 5 years. If you need tech talent, let's talk!",
    h1: ['If you want', 'different results', 'stop doing always', 'the same'],
    intro: "We are doers! The tech ecosystem is more vibrant and fast-changing than ever. We've demonstrated that new recruiting methods are possible and have been implementing them for over 5 years!",
    introStrong: "If you need tech talent, let's talk!",
    talk: 'Should we meet?',
    what: ['What we ', 'do'],
    services: [
      ['Tech Headhunting', 'Direct search of business profiles and developers', '2020/12/about-picto-3.png'],
      ['HR Dream Team', 'We build your internal Human Resources team', '2020/12/about-picto-2.png'],
      ['Employer Branding', 'We define a value proposition for your employer brand', '2020/12/about-picto-1.png'],
    ],
    how: [['Not ', 'what'], ['but ', 'how']],
    values: ['Quality, quality, quality', 'Flexibility, agility and energy'],
    teamTitle: 'The team',
    roles: ['Co-founder multitasker', 'Co-founder, consultant'],
    bios: [
      'Multitasker, optimistic and restless. Obsessed with documentaries. Maximum precision in every detail. Cris does magic to product and business processes.',
      'Extreme techie and athletic. The strategic mind behind the team. He is a rock star handling Data, Agile/Scrum, Security and DevOps.',
    ],
    write: 'Email',
  },
}[lang];
const other = lang === 'es' ? routes.about.en : routes.about.es;
---
<Base lang={lang} title={t.title} description={t.description} alt={other}>
  <section class="intro grad">
    <div class="wrap split">
      <h1 class="display">
        <Hl>{t.h1[0]}</Hl><br />
        <Hl h="var(--lilac-soft)">{t.h1[1]}</Hl><br />
        <Hl>{t.h1[2]}</Hl><br />
        <Hl h="var(--orange)"><em>{t.h1[3]}</em></Hl>
      </h1>
      <div>
        <p class="lead">{t.intro}</p>
        <p><strong>{t.introStrong}</strong></p>
        <a class="btn btn-purple" href={routes.contact[lang]}>{t.talk}</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="title center"><Hl h="var(--orange)">{t.what[0]}<em>{t.what[1]}</em></Hl></h2>
      <ul class="services">
        {t.services.map(([name, text, img]) => (
          <li>
            <img src={up(img)} alt="" width="120" height="120" loading="lazy" />
            <h3>{name}</h3>
            <p>{text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section how on-dark">
    <div class="wrap center">
      <h2 class="display">
        <Hl c="#fff" h="var(--purple-deep)">{t.how[0][0]}<em>{t.how[0][1]}</em></Hl><br />
        <Hl c="#fff" h="var(--purple-deep)">{t.how[1][0]}<em>{t.how[1][1]}</em></Hl>
      </h2>
      <p class="title value aqua">{t.values[0]}</p>
      <p class="title value yellow">{t.values[1]}</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="title center">{t.teamTitle}</h2>
      <ul class="team">
        {team.map((p, i) => (
          <li>
            <img src={up(p.img)} alt={`${p.first} ${p.last}`} width="400" height="400" loading="lazy" />
            <h3><Hl h="var(--orange)">{p.first}</Hl><br /><span>{p.last}</span></h3>
            <p class="role">{t.roles[i]}</p>
            <p>{t.bios[i]}</p>
            <p class="links">
              <a href={`mailto:${p.email}`} aria-label={`${t.write} ${p.first}`}><Icon name="mail" /></a>
              <a href={p.linkedin} target="_blank" rel="noopener" aria-label={`LinkedIn ${p.first} ${p.last}`}><Icon name="linkedin" /></a>
            </p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<style>
  .intro { padding: clamp(72px, 12vw, 150px) 0; }
  .split { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(24px, 5vw, 72px); align-items: center; }
  .lead { font-size: 1.15rem; }
  .services { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px; text-align: center; }
  .services img { margin: 0 auto 16px; width: 110px; }
  .services h3 { font-size: 1.4rem; }
  .how { background: var(--violet); }
  .how .value { margin: 12px 0; font-weight: 800; }
  .how .aqua { color: var(--aqua); }
  .how .yellow { color: var(--yellow); }
  .team { list-style: none; padding: 0; margin: 48px 0 0; display: grid; grid-template-columns: repeat(2, minmax(0, 360px)); justify-content: center; gap: 40px clamp(32px, 6vw, 80px); }
  .team img { border-radius: var(--radius); aspect-ratio: 1; object-fit: cover; width: 100%; margin-bottom: 18px; background: var(--soft); }
  .team h3 { font-size: 2rem; margin-bottom: 6px; }
  .team h3 span { font-weight: 500; font-size: 1.4rem; }
  .team .role { font-weight: 700; color: var(--coral-deep); margin-bottom: 8px; }
  .links { display: flex; gap: 10px; }
  .links a { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--violet); color: var(--violet); transition: background-color 0.2s, color 0.2s; }
  .links a:hover { background: var(--violet); color: #fff; }
  @media (max-width: 820px) {
    .split, .services { grid-template-columns: 1fr; }
    .team { grid-template-columns: minmax(0, 360px); }
  }
</style>
