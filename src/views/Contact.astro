---
import Base from '../layouts/Base.astro';
import Hl from '../components/Hl.astro';
import LeadForm from '../components/LeadForm.astro';
import { routes, site, up, type Lang } from '../lib/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = {
  es: {
    title: 'Contacto | Melza Tech Headhunting',
    description: '¿Buscas el candidato ideal? ¿Necesitas un cambio laboral? Ya seas empresa o candidato, escríbenos o llámanos. Estamos en Barcelona.',
    lead: ['¿Buscas el candidato ideal? ¿Necesitas un cambio laboral?', 'Ya seas empresa o candidato, te estamos esperando.'],
    email: 'E-mail',
    phone: 'Teléfono',
    hq: 'Headquarters',
    street: 'Diagonal 601, 8ª planta',
    txt: '¿Eres más de .txt?',
  },
  en: {
    title: 'Contact | Melza Tech Headhunting',
    description: 'Looking for the ideal candidate? Need a career change? Whether you are a company or a candidate, write or call us. We are in Barcelona.',
    lead: ['Looking for the ideal candidate? Need a career change?', 'Either if you are a company or a candidate, we are waiting for you.'],
    email: 'E-mail',
    phone: 'Phone number',
    hq: 'Headquarters',
    street: 'Diagonal 601, 8th floor',
    txt: 'Do you prefer .txt?',
  },
}[lang];
const other = lang === 'es' ? routes.contact.en : routes.contact.es;
---
<Base lang={lang} title={t.title} description={t.description} alt={other}>
  <section class="intro grad">
    <div class="wrap split">
      <div class="reveal">
        <h1 class="display-xl"><Hl c="#fff">Let's</Hl> <Hl c="var(--red)"><em>Talk</em></Hl></h1>
        <p class="lead">{t.lead[0]}<br />{t.lead[1]}</p>
      </div>
      <img class="reveal" src={up('2020/12/contacto-top-img.png')} alt="" width="560" height="460" />
    </div>
  </section>

  <section class="section">
    <div class="wrap grid">
      <ul class="ways">
        <li>
          <img src={up('2020/12/contacto-picto-email.png')} alt="" width="64" height="64" loading="lazy" />
          <h2>{t.email}</h2>
          <a class="btn btn-coral" href={`mailto:${site.email}`}>{site.email}</a>
        </li>
        <li>
          <img src={up('2020/12/contacto-picto-telefono.png')} alt="" width="64" height="64" loading="lazy" />
          <h2>{t.phone}</h2>
          <a class="btn btn-coral" href={site.phoneHref}>{site.phone}</a>
        </li>
        <li>
          <img src={up('2020/12/contacto-picto-oficina.png')} alt="" width="64" height="64" loading="lazy" />
          <h2>{t.hq}</h2>
          <address>{t.street}<br />{site.address.zip} {site.address.city}</address>
        </li>
      </ul>
      <div>
        <h2>{t.txt}</h2>
        <LeadForm lang={lang} kind="contact" />
      </div>
    </div>
  </section>
</Base>

<style>
  .intro { padding: clamp(64px, 10vw, 130px) 0; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 64px); align-items: center; }
  .lead { font-size: 1.2rem; font-weight: 600; }
  .grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: clamp(32px, 6vw, 80px); align-items: start; }
  .ways { list-style: none; padding: 0; margin: 0; display: grid; gap: 36px; }
  .ways img { width: 56px; margin-bottom: 10px; }
  .ways h2 { font-size: 1.3rem; }
  address { font-style: normal; font-weight: 600; }
  @media (max-width: 820px) { .split, .grid { grid-template-columns: 1fr; } }
</style>
