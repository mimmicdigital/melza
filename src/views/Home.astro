    newTab: '(se abre en una pestaña nueva)',
    servicesLink: 'Conoce el equipo',
    services: [
      ['Tech Headhunting', 'Búsqueda directa de perfiles de negocio y developers'],
      ['HR Dream Team', 'Construimos tu equipo interno de Recursos Humanos'],
      ['Employer Branding', 'Definimos tu propuesta de valor como marca empleadora'],
    ],
    start: '¿Empezamos?',
    candidates: 'Candidatos',
    companies: 'Empresas',
    companiesId: 'empresas',
    congrats: ['¡', 'Enhora', 'buena!'],
    need: 'Parece que necesitas',
    expand: ['Ampliar', ' el'],
    team: 'Equipo',
    heard: ['¿Te han hablado', 'ya del'],
    method: 'método Melza?',
    easy: 'Hacemos fácil lo difícil',
    easyText: 'Proponemos, nos anticipamos, ofrecemos agilidad en el proceso y calidad del talento presentado.',
    prove: '¿Te lo demostramos?',
    video: 'Ver el vídeo de presentación',
    numbers: ['Somos de ', 'números', ' ...'],
    letters: ['... y de ', 'letras'],
    stats: [
      ['175', 'Vacantes cubiertas', '2020/11/home-picto-vacantes.jpg'],
      ['32375', 'Aspirantes', '2020/11/home-picto-aspirantes.jpg'],
      ['3885', 'Entrevistas', '2020/11/home-picto-entrevistas.jpg'],
      ['525', 'Candidatos finalistas', '2020/11/home-picto-candidatos.jpg'],
    ],
    partners: ['Partners', ' in crime'],
    quotes: [
      { quote: 'Gracias a Cristian de Melza tuve la oportunidad de dar un salto profesional muy importante y entrar como CISO en SCRM Lidl International Hub. Además, me han ayudado desde el minuto 0 a crear mi equipo de la forma más eficiente posible. Melza tiene una capacidad de búsqueda de talento digital difícil de encontrar en el ecosistema de headhunting actual, 100% recomendable :)', name: 'Xavi Bertomeu', role: 'CISO & IT Director - SCRM Lidl International Hub' },
      { quote: 'Necesitábamos incorporar un desarrollador durante el periodo del Covid-19, parecía imposible encontrar candidatos pero el equipo de Melza, en muy poco tiempo, nos consiguió perfiles que se ajustaban al 100% a nuestros requisitos. Desde entonces les confiamos a ellos todos nuestros procesos de selección.', name: 'Jordi Polo', role: 'Cofounder & CTO - StormDigital' },
      { quote: 'El conocimiento técnico de Melza y su forma de trabajar codo con codo con la empresa, les permite entender muy bien las necesidades de la empresa y junto con su conocimiento de mercado, consiguen atraer candidatos que no buscan trabajo de forma activa a todos los procesos.', name: 'Francisco Trinxet', role: 'CPO Omnichannel Products - SCRM Lidl International Hub' },
    ],
  },
  en: {
    title: 'Melza Tech Headhunting | WOW People for TOP Employers | Agile',
    description: 'At Melza we help candidates and companies find each other. We make the hardest quite easy by anticipating and offering agility in the process.',
    newTab: '(opens in a new tab)',
    servicesLink: 'Meet the team',
    services: [
      ['Tech Headhunting', 'Direct search of business profiles and developers'],
      ['HR Dream Team', 'We build your internal Human Resources team'],
      ['Employer Branding', 'We define a value proposition for your employer brand'],
    ],
    start: 'Should we start?',
    candidates: 'Candidates',
    companies: 'Companies',
    companiesId: 'companies',
    congrats: ['', 'Congratulations', '!'],
    need: 'It looks like you need',
    expand: ['to expand', ' your'],
    team: 'Team',
    heard: ['Have you heard', 'about the'],
    method: 'Melza method?',
    easy: 'We make the hardest quite easy',
    easyText: 'We propose, anticipate ourselves, offer agility in the process and quality in the provided talent.',
    prove: 'Want us to prove it?',
    video: 'Watch our presentation video',
    numbers: ['We believe in ', 'numbers', ' ...'],
    letters: ['... and in ', 'letters'],
    stats: [
      ['175', 'Vacancies filled', '2020/11/home-picto-vacantes.jpg'],
      ['32375', 'Candidates', '2020/11/home-picto-aspirantes.jpg'],
      ['3885', 'Interviews', '2020/11/home-picto-entrevistas.jpg'],
      ['525', 'Final candidates', '2020/11/home-picto-candidatos.jpg'],
    ],
    partners: ['Partners', ' in crime'],
    quotes: [
      { quote: "Thanks to Cristian from Melza I had the chance to take a big step in my professional career and join SCRM Lidl International Hub as CISO. They've also helped me build my team in the most efficient way possible. Melza has a great capacity in recruiting digital talent which tends to be hard to find in the current headhunting ecosystem, 100% recommended :)", name: 'Xavi Bertomeu', role: 'CISO & IT Director - SCRM Lidl International Hub' },
      { quote: 'We needed to incorporate a developer during Covid-19, it looked impossible to find the right candidates. The Melza team chose profiles which fit perfectly with our requirements in a record time. Since then, we rely on them for all our recruiting processes.', name: 'Jordi Polo', role: 'Cofounder & CTO - StormDigital' },
      { quote: 'The technical knowledge of Melza and their approachable work methodology allows them to perfectly understand the needs of the company which, together with their expertise in the market, enables them to attract candidates who might not be actively looking for new job opportunities elsewhere.', name: 'Francisco Trinxet', role: 'CPO Omnichannel Products - SCRM Lidl International Hub' },
    ],
  },
}[lang];

const other = lang === 'es' ? routes.home.en : routes.home.es;
const fmt = new Intl.NumberFormat(lang === 'es' ? 'es-ES' : 'en-GB');
---
<Base lang={lang} title={t.title} description={t.description} alt={other}>
  <section class="hero">
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <h1 class="display-xl"><Hl h="var(--aqua)">WOW</Hl> People<br />for <Hl>TOP</Hl> employers</h1>
        <p class="lead">{t.description}</p>
        <p class="start">{t.start}</p>
        <div class="actions">
          <a class="btn btn-ink" href={`#${t.companiesId}`}>{t.companies}</a>
          <a class="btn btn-white" href={routes.candidates[lang]}>{t.candidates}</a>
        </div>
      </div>
      <img class="hero-img" src={up('2020/11/home-BG-img.jpg')} alt="" width="1133" height="1204" fetchpriority="high" />
    </div>
  </section>

  <section id={t.companiesId} class="companies grad">
    <div class="wrap">
      <div class="block center">
        <img class="gif" src={up('2020/11/home-great-job.gif')} alt="" width="640" height="420" loading="lazy" />
        <h2 class="display"><Hl>{t.congrats[0]}<em>{t.congrats[1]}</em>{t.congrats[2]}</Hl></h2>
      </div>
      <div class="split">
        <h2 class="display">
          <Hl>{t.need}</Hl><br />
          <Hl><em>{t.expand[0]}</em>{t.expand[1]}</Hl> <Hl h="var(--aqua)"><em>{t.team}</em></Hl>
        </h2>
        <img class="gif" src={up('2020/11/home-ampliar-equipo.gif')} alt="" width="560" height="420" loading="lazy" />
      </div>
      <div class="split flip">
        <img class="gif" src={up('2020/11/home-metodo.gif')} alt="" width="560" height="420" loading="lazy" />
        <h2 class="display">
          <Hl>{t.heard[0]}</Hl><br /><Hl>{t.heard[1]}</Hl><br />
          <Hl><em>{t.method}</em></Hl>
        </h2>
      </div>
    </div>
  </section>

  <section class="section agile">
    <div class="wrap split">
      <div>
        <h2 class="display-xl agile-title">
          <Hl h="var(--orange)">Agile</Hl><br />
          <Hl h="var(--blue)">Shortlist</Hl><br />
          <Hl>Talent</Hl>
        </h2>
        <h3>{t.easy}</h3>
        <p>{t.easyText}</p>
        <ul class="services">
          {t.services.map(([name, text]) => <li><strong>{name}</strong> {text}</li>)}
        </ul>
        <div class="actions">
          <a class="btn btn-ink" href={routes.contact[lang]}>{t.prove}</a>
          <a class="btn btn-line" href={site.vimeo} target="_blank" rel="noopener"><Icon name="play" /> {t.video}<span class="sr"> {t.newTab}</span></a>
        </div>
      </div>
      <img class="gif" src={up('2020/11/home-shortlist-talent.gif')} alt="" width="560" height="420" loading="lazy" />
    </div>
  </section>

  <section class="section numbers">
    <div class="wrap">
      <h2 class="title center"><Hl>{t.numbers[0]}<em>{t.numbers[1]}</em>{t.numbers[2]}</Hl></h2>
      <ul class="stats">
        {t.stats.map(([n, label, img]) => (
          <li>
            <img src={up(img)} alt="" width="120" height="120" loading="lazy" />
            <strong data-count={n}>{fmt.format(Number(n))}</strong>
            <span>{label}</span>
          </li>
        ))}
      </ul>
      <h2 class="title center letters"><Hl>{t.letters[0]}<em>{t.letters[1]}</em></Hl></h2>
      <Testimonials items={t.quotes} />
    </div>
  </section>

  <section class="section partners">
    <div class="wrap">
      <h2 class="title center"><Hl><em>{t.partners[0]}</em>{t.partners[1]}</Hl></h2>
      <Clients />
    </div>
  </section>

  <CtaBand lang={lang} />
</Base>

<script>
  // Count the figures up once they come into view.
  const fmt = new Intl.NumberFormat(document.documentElement.lang === 'es' ? 'es-ES' : 'en-GB');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const io = new IntersectionObserver((entries) => {
    for (const e of entries) {
      if (!e.isIntersecting) continue;
      io.unobserve(e.target);
      const el = e.target as HTMLElement;
      const end = Number(el.dataset.count);
      if (reduce) { el.textContent = fmt.format(end); continue; }
      const t0 = performance.now();
      const step = (now: number) => {
        const p = Math.min(1, (now - t0) / 1600);
        el.textContent = fmt.format(Math.round(end * (1 - Math.pow(1 - p, 3))));
        if (p < 1) requestAnimationFrame(step);
      };
      requestAnimationFrame(step);
    }
  });
  document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
    if (!reduce) el.textContent = fmt.format(0);
    io.observe(el);
  });
</script>

<style>
  .hero { background: var(--coral); color: var(--violet); overflow: hidden; }
  .hero-inner { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: clamp(24px, 4vw, 56px); align-items: end; padding-top: clamp(48px, 8vw, 96px); }
  .hero-copy { padding-bottom: clamp(48px, 8vw, 96px); align-self: center; }
  .hero .lead { max-width: 34em; font-weight: 600; margin-top: 24px; }
  .hero-img { width: 100%; max-width: 520px; justify-self: end; display: block; }
  .start { font-size: clamp(1.3rem, 2.4vw, 1.8rem); font-weight: 800; text-transform: uppercase; margin: 24px 0 18px; }
  .actions { display: flex; flex-wrap: wrap; gap: 12px; }
  .companies { padding: clamp(72px, 12vw, 160px) 0; }
  .block { margin-bottom: clamp(56px, 9vw, 120px); }
  .block .gif { margin: 0 auto 24px; width: 100%; max-width: 520px; }
  .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(24px, 5vw, 72px); align-items: center; margin-bottom: clamp(56px, 9vw, 120px); }
  .split:last-child { margin-bottom: 0; }
  .gif { border-radius: var(--radius); }
  .agile .split { margin-bottom: 0; }
  .agile-title { line-height: 1.02; margin-bottom: 0.4em; }
  .agile h3 { font-size: 1.5rem; }
  .agile .actions { margin-top: 24px; }
  .stats { list-style: none; padding: 0; margin: 48px 0 clamp(56px, 8vw, 100px); display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; text-align: center; }
  .stats img { margin: 0 auto 12px; width: 96px; }
  .stats strong { display: block; font-size: clamp(2.2rem, 4vw, 3.2rem); color: var(--violet); line-height: 1.1; font-variant-numeric: tabular-nums; }
  .stats span { font-weight: 600; }
  .letters { margin-bottom: 40px; }
  .services { list-style: none; padding: 0; margin: 20px 0 0; display: grid; gap: 10px; }
  .services li { padding-left: 18px; border-left: 3px solid var(--coral); }
  .services strong { display: block; color: var(--violet); }
  .partners h2 { margin-bottom: 40px; }
  @media (max-width: 820px) {
    .split, .hero-inner { grid-template-columns: 1fr; }
    .hero-copy { padding-bottom: 0; }
    .hero-img { justify-self: center; max-width: 360px; }
    .split.flip img { order: 2; }
    .stats { grid-template-columns: repeat(2, 1fr); }
  }
</style>
